#!/bin/bash
set -eu

# /opt/nvidia/l4t-gpusetup is a layout bind onto writable $SNAP_DATA, it starts
# empty on a fresh install. In Thor nvpmodel decides "Reboot required" by comparing the
# stored gpu_pg_mask_param against the mode's target, and it only rewrites the
# existing gpu_pg_mask file; it never creates one.
# Therefore this install hook creates a new /opt/nvidia/l4t-gpusetup/gpu_pg_mask file

GPUSETUP_DIR="/opt/nvidia/l4t-gpusetup"
GPUSETUP_SEED="$SNAP/opt/nvidia/l4t-gpusetup/gpu_pg_mask"

if [ ! -f "$GPUSETUP_DIR/gpu_pg_mask" ] && [ -f "$GPUSETUP_SEED" ]; then
    mkdir -p "$GPUSETUP_DIR"
    cp "$GPUSETUP_SEED" "$GPUSETUP_DIR/gpu_pg_mask"
fi
